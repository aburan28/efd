name generalized Huff curves
parameter a
parameter b
coordinate x
coordinate y
satisfying x*(a*y^2-1) == y*(b*x^2-1)
negation x = -x1
negation y = -y1
neutral x = 0
neutral y = 0
toweierstrass u = 1/(x*y)
toweierstrass v = (1+b*x*y)/(x*y^2)
a0 = 1
a1 = 0
a2 = a+b
a3 = 0
a4 = a*b
a6 = 0
fromweierstrass x = v/(u*(u+b))
fromweierstrass y = v/(u*(u+a))
