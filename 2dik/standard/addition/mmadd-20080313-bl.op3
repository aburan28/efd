A = Y2-Y1
AA = A^2
B = X2-X1
CC = B^2
F = X1*CC
Z3 = 2*CC
D = X2*Z3
ZZ3 = Z3^2
efdtmp0 = AA-F
efdtmp1 = 2*efdtmp0
efdtmp2 = a*Z3
efdtmp3 = efdtmp1-efdtmp2
X3 = efdtmp3-D
efdtmp4 = A+B
efdtmp5 = efdtmp4^2
efdtmp6 = efdtmp5-AA
efdtmp7 = efdtmp6-CC
efdtmp8 = D-X3
efdtmp9 = efdtmp7*efdtmp8
efdtmp10 = Y2*ZZ3
Y3 = efdtmp9-efdtmp10
