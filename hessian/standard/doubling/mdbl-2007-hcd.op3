A = X1^2
B = Y1^2
D = A+B
efdtmp0 = X1+Y1
efdtmp1 = efdtmp0^2
G = efdtmp1-D
efdtmp2 = 2*Y1
efdtmp3 = efdtmp2-G
efdtmp4 = X1+A
efdtmp5 = efdtmp4+1
X3 = efdtmp3*efdtmp5
efdtmp6 = 2*X1
efdtmp7 = G-efdtmp6
efdtmp8 = Y1+B
efdtmp9 = efdtmp8+1
Y3 = efdtmp7*efdtmp9
efdtmp10 = X1-Y1
efdtmp11 = 2*D
efdtmp12 = G+efdtmp11
Z3 = efdtmp10*efdtmp12
