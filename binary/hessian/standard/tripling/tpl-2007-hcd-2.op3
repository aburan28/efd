XX = X1^2
A = XX*X1
YY = Y1^2
B = YY*Y1
ZZ = Z1^2
C = ZZ*Z1
AB = A-B
BC = B-C
CA = C-A
U = B*CA
V = A*BC
efdtmp0 = U*AB
efdtmp1 = V*BC
efdtmp2 = efdtmp0-efdtmp1
X3 = a*efdtmp2
efdtmp3 = V*AB
efdtmp4 = U*CA
efdtmp5 = efdtmp3-efdtmp4
Y3 = a*efdtmp5
efdtmp6 = A+B
efdtmp7 = efdtmp6+C
efdtmp8 = BC*CA
efdtmp9 = AB^2
efdtmp10 = efdtmp8-efdtmp9
Z3 = efdtmp7*efdtmp10
