source 2015 Chung--Costello--Smith, Fast, uniform, and compact scalar multiplication, Section 5.3, Brier--Joye recovery formula, https://arxiv.org/abs/1510.03174
assume Z1 = 1
compute A = X1*Z2+X2
compute B = a*Z2+X1*X2
compute C = X1*Z2-X2
compute N = 2*b*Z2^2*Z3+A*B*Z3-X3*C^2
compute Z4 = 2*Y1*Z2^2*Z3
compute X4 = 2*Y1*X2*Z2*Z3
compute Y4 = N
