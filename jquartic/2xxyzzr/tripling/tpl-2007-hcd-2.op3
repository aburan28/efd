UU = XX1^2
WW = ZZ1^2
RR = R1^2
efdtmp0 = UU-WW
A = 4*efdtmp0
AA = A^2
efdtmp1 = UU+WW
efdtmp2 = 2*efdtmp1
efdtmp3 = a*RR
B = efdtmp2+efdtmp3
BB = B^2
efdtmp4 = A+B
efdtmp5 = efdtmp4^2
efdtmp6 = efdtmp5-AA
AB = efdtmp6-BB
efdtmp7 = RR^2
C = b*efdtmp7
efdtmp8 = BB-C
Q = 2*efdtmp8
efdtmp9 = AB-Q
X3 = X1*efdtmp9
efdtmp10 = AB+Q
Z3 = Z1*efdtmp10
efdtmp11 = Q^2
efdtmp12 = 4*AA
efdtmp13 = efdtmp12*C
efdtmp14 = efdtmp11-efdtmp13
Y3 = Y1*efdtmp14
XX3 = X3^2
ZZ3 = Z3^2
efdtmp15 = X3+Z3
efdtmp16 = efdtmp15^2
efdtmp17 = efdtmp16-XX3
R3 = efdtmp17-ZZ3
