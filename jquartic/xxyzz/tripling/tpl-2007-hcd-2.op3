UU = XX1^2
WW = ZZ1^2
efdtmp0 = X1+Z1
efdtmp1 = efdtmp0^2
efdtmp2 = efdtmp1-XX1
efdtmp3 = efdtmp2-ZZ1
RR = efdtmp3^2
efdtmp4 = UU-WW
A = 4*efdtmp4
AA = A^2
efdtmp5 = UU+WW
efdtmp6 = 2*efdtmp5
efdtmp7 = a*RR
B = efdtmp6+efdtmp7
BB = B^2
efdtmp8 = A+B
efdtmp9 = efdtmp8^2
efdtmp10 = efdtmp9-AA
AB = efdtmp10-BB
efdtmp11 = RR^2
C = b*efdtmp11
efdtmp12 = BB-C
Q = 2*efdtmp12
efdtmp13 = AB-Q
X3 = X1*efdtmp13
efdtmp14 = AB+Q
Z3 = Z1*efdtmp14
efdtmp15 = Q^2
efdtmp16 = 4*AA
efdtmp17 = efdtmp16*C
efdtmp18 = efdtmp15-efdtmp17
Y3 = Y1*efdtmp18
XX3 = X3^2
ZZ3 = Z3^2
