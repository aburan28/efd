A = XX1^2
B = Y1^2
efdtmp0 = XX1+B
efdtmp1 = X1+Y1
efdtmp2 = efdtmp1^2
X3 = efdtmp0-efdtmp2
Z3 = A-1
XX3 = X3^2
ZZ3 = Z3^2
T3 = XX3+ZZ3
efdtmp3 = X3+Z3
efdtmp4 = efdtmp3^2
R3 = efdtmp4-T3
efdtmp5 = 2*B
efdtmp6 = 2*XX1
efdtmp7 = A+efdtmp6
efdtmp8 = efdtmp7+1
efdtmp9 = efdtmp5*efdtmp8
Y3 = efdtmp9-T3
