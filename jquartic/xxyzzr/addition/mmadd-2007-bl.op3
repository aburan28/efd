E1 = X1+Y1
E2 = X2+Y2
B = X1*X2
XX1XX2 = B^2
Y1Y2 = Y1*Y2
F = 1+XX1XX2
G = 2*B
efdtmp0 = E1*E2
efdtmp1 = efdtmp0-B
X3 = efdtmp1-Y1Y2
efdtmp2 = a*G
efdtmp3 = Y1Y2+efdtmp2
efdtmp4 = F*efdtmp3
