  "transformations": [
    {
      "id": "montgomery-to-shortw",
      "source": "montgom",
      "target": "shortw",
      "kind": "birational_isomorphism",
      "target_parameters": {
        "a": "(1-a**2/3)/b**2",
        "b": "(2*a**3/27-a/3)/b**3"
      },
      "forward": {
        "x": "(x+a/3)/b",
        "y": "y/b"
      },
      "inverse": {
        "x": "b*x-a/3",
        "y": "b*y"
      },
      "requires": [
        "characteristic > 3",
        "b != 0"
      ],
      "source_substitutions": {},
      "affine_exceptions": [
        "No finite chart poles; infinity maps to infinity."
      ],
      "sources": [
        "efd"
      ],
      "verification": "symbolic curve identity and inverse on the open chart; see tests/test_transformations.py"
    },
    {
      "id": "shortw-to-montgomery",
      "source": "shortw",
      "target": "montgom",
      "kind": "birational_isomorphism",
      "target_parameters": {
        "a": "3*r/s",
        "b": "1/s"
      },
      "forward": {
        "x": "(x-r)/s",
        "y": "y/s"
      },
      "inverse": {
        "x": "s*x+r",
        "y": "s*y"
      },
      "requires": [
        "characteristic > 3",
        "r**3+a*r+b == 0",
        "s**2 == 3*r**2+a",
        "s != 0",
        "r and s must lie in the stated field"
      ],
      "source_substitutions": {
        "a": "s**2-3*r**2",
        "b": "2*r**3-r*s**2"
      },
      "affine_exceptions": [
        "No finite chart poles; infinity maps to infinity. A rational root r alone is insufficient: 3*r**2+a must be a square."
      ],
      "sources": [
        "efd",
        "twisted"
      ],
      "verification": "symbolic curve identity and inverse on the open chart; see tests/test_transformations.py"
    },
    {
      "id": "montgomery-to-twisted",
      "source": "montgom",
      "target": "twisted",
      "kind": "birational_isomorphism",
      "target_parameters": {
        "a": "(a+2)/b",
        "d": "(a-2)/b"
      },
      "forward": {
        "x": "x/y",
        "y": "(x-1)/(x+1)"
      },
      "inverse": {
        "x": "(1+y)/(1-y)",
        "y": "(1+y)/(x*(1-y))"
      },
      "requires": [
        "characteristic > 3",
        "b != 0",
        "a**2 != 4"
      ],
      "source_substitutions": {},
      "affine_exceptions": [
        "Forward excludes y=0 or x=-1; inverse excludes x=0 or y=1. On smooth completions: O -> (0,1), (0,0) -> (0,-1). Other missing points require projective charts."
      ],
      "sources": [
        "twisted"
      ],
      "verification": "symbolic curve identity and inverse on the open chart; see tests/test_transformations.py"
    },
    {
      "id": "montgomery-to-minus-one-twisted",
      "source": "montgom",
      "target": "twisted",
      "kind": "birational_isomorphism",
      "target_parameters": {
        "a": "-1",
        "d": "(a-2)/(b*s**2)"
      },
      "forward": {
        "x": "s*x/y",
        "y": "(x-1)/(x+1)"
      },
      "inverse": {
        "x": "(1+y)/(1-y)",
        "y": "s*(1+y)/(x*(1-y))"
      },
      "requires": [
        "characteristic > 3",
        "s**2 == -(a+2)/b",
        "s != 0",
        "s in the base field, otherwise an extension is needed"
      ],
      "source_substitutions": {
        "a": "-b*s**2-2"
      },
      "affine_exceptions": [
        "Same affine exceptions and completion values as montgomery-to-twisted. Fix a choice of s; changing its sign negates the Edwards x coordinate."
      ],
      "sources": [
        "rfc7748"
      ],
      "verification": "symbolic curve identity and inverse on the open chart; see tests/test_transformations.py"
    },
    {
      "id": "twisted-to-minus-one",
      "source": "twisted",
      "target": "twisted",
      "kind": "birational_isomorphism",
      "target_parameters": {
        "a": "-1",
        "d": "d/s**2"
      },
      "forward": {
        "x": "s*x",
        "y": "y"
      },
      "inverse": {
        "x": "x/s",
        "y": "y"
      },
      "requires": [
        "characteristic > 3",
        "s**2 == -a",
        "s != 0",
        "s in the stated field"
      ],
      "source_substitutions": {
        "a": "-s**2"
      },
      "affine_exceptions": [
        "No finite chart poles."
      ],
      "sources": [
        "twisted"
      ],
      "verification": "symbolic curve identity and inverse on the open chart; see tests/test_transformations.py"
    },
    {
      "id": "twisted-to-edwards",
      "source": "twisted",
      "target": "edwards",
      "kind": "birational_isomorphism",
      "target_parameters": {
        "c": "1",
        "d": "d/s**2"
      },
      "forward": {
        "x": "s*x",
        "y": "y"
      },
      "inverse": {
        "x": "x/s",
        "y": "y"
      },
      "requires": [
        "characteristic > 3",
        "s**2 == a",
        "s != 0",
        "s in the stated field"
      ],
      "source_substitutions": {
        "a": "s**2"
      },
      "affine_exceptions": [
        "No finite chart poles. This target uses the repository Edwards convention with c=1."
      ],
      "sources": [
        "twisted"
      ],
      "verification": "symbolic curve identity and inverse on the open chart; see tests/test_transformations.py"
    },
    {
      "id": "edwards-to-twisted",
      "source": "edwards",
      "target": "twisted",
      "kind": "birational_isomorphism",
      "target_parameters": {
        "a": "1",
        "d": "d*c**4"
      },
      "forward": {
        "x": "x/c",
        "y": "y/c"
      },
      "inverse": {
        "x": "c*x",
        "y": "c*y"
      },
      "requires": [
        "characteristic > 3",
        "c != 0"
      ],
      "source_substitutions": {},
      "affine_exceptions": [
        "No finite chart poles; (0,c) -> (0,1)."
      ],
      "sources": [
        "efd"
      ],
      "verification": "symbolic curve identity and inverse on the open chart; see tests/test_transformations.py"
    },
    {
      "id": "shortw-scaling",
      "source": "shortw",
      "target": "shortw",
      "kind": "birational_isomorphism",
      "target_parameters": {
        "a": "a/t**4",
        "b": "b/t**6"
      },
      "forward": {
        "x": "x/t**2",
        "y": "y/t**3"
      },
      "inverse": {
        "x": "t**2*x",
        "y": "t**3*y"
      },
      "requires": [
        "characteristic > 3",
        "t != 0",
        "t in the stated field"
      ],
      "source_substitutions": {},
      "affine_exceptions": [
        "No finite chart poles; infinity maps to infinity. Cannot generally force a=0 or a=-3: the latter requires t**4=-a/3."
      ],
      "sources": [
        "efd"
      ],
      "verification": "symbolic curve identity and inverse on the open chart; see tests/test_transformations.py"
    }
  ],
