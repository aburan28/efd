{
  "schema_version": 1,
  "scope": "Curated transformation atlas for the four models already exported in this repository; not an exhaustive classification of genus-one models.",
  "conventions": {
    "field": "F_p, p > 3 unless a field extension is explicitly selected",
    "expressions": "Python-style ** powers; exact rational arithmetic, never floating point. Parse only trusted catalog expressions.",
    "symbols": "Forward and target_parameters use SOURCE parameters a,b,c,d and source x,y. Inverse uses TARGET x,y but the ORIGINAL source parameters and auxiliary r,s,t. All substitutions are simultaneous.",
    "auxiliaries": "r,s,t are field elements chosen to satisfy requires, not free parameters.",
    "exceptions": "Rational formulas apply only on the stated open affine charts; birational maps extend to smooth projective completions.",
    "eligibility": "recommended_coordinates are candidates for benchmarking, not measured winners. base_field_models refers only to the four catalog model families."
  },
  "sources": {
    "efd": {
      "url": "https://www.hyperelliptic.org/EFD/",
      "scope": "Model equations and coordinate representations; local files remain canonical."
    },
    "rfc7748": {
      "url": "https://www.rfc-editor.org/rfc/rfc7748#section-4.1",
      "scope": "Curve25519 parameters and normalized Edwards map. Section 5: a24-minus-two doubling and ladder."
    },
    "sec2": {
      "url": "https://www.secg.org/sec2-v2.pdf",
      "scope": "Sections 2.4.1 and 2.4.2: secp256k1 and secp256r1 parameters."
    },
    "twisted": {
      "url": "https://eprint.iacr.org/2008/013",
      "scope": "Bernstein et al., Twisted Edwards Curves; Montgomery equivalence."
    },
    "semaev": {
      "url": "https://eprint.iacr.org/2004/031",
      "scope": "Summation polynomials; bibliographic reference, PDF unavailable during this session."
    }
  },
  "models": {
    "shortw": {
      "path": "shortw/coordinates",
      "nonsingular": "4*a**3+27*b**2 != 0"
    },
    "montgom": {
      "path": "montgom/coordinates",
      "nonsingular": "b != 0 and a**2 != 4"
    },
    "twisted": {
      "path": "twisted/coordinates",
      "nonsingular": "a*d*(a-d) != 0"
    },
    "edwards": {
      "path": "edwards/coordinates",
      "nonsingular": "c*d*(1-d*c**4) != 0"
    }
  },
