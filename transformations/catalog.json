  "related_operations": [
    {
      "kind": "isogeny",
      "invertible": false,
      "note": "Not a coordinate change. On an order-l subgroup, transport an ECDLP only when the map is nonzero/injective there (in particular l coprime to degree). Kernel and dual map matter; same-field isogenous curves have equal point counts, so an odd-order isogeny class cannot acquire rational 2-torsion."
    },
    {
      "kind": "quadratic_twist",
      "invertible": false,
      "note": "Generally not F_p-isomorphic. For nonsquare D, y^2=x^3+D^2*a*x+D^3*b becomes isomorphic over F_p(sqrt(D)); the twist is a different base-field group."
    },
    {
      "kind": "field_extension",
      "invertible": false,
      "note": "Model availability can change; track extension degree, source subgroup and extra variables. No prime-field speedup follows automatically."
    }
